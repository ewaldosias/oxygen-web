        {/* OTP */}
        {step === 'otp' && (
          <div className="fu">
            <div style={{fontFamily:'Manrope, sans-serif',fontSize:'34px',fontWeight:400,lineHeight:1.2,marginBottom:'6px'}}>Kòd ou resevwa a</div>
